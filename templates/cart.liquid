{% layout 'theme' %}

{% if cart.item_count > 0 %}
  <style>
    .ll-cart-wrap { max-width: 560px; margin: 60px auto; padding: 24px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .ll-cart-title { font-size: 1.5rem; font-weight: 800; color: #0f2a1f; margin-bottom: 24px; }
    .ll-cart-item { display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-bottom: 1px solid #e5e7eb; }
    .ll-cart-name { font-weight: 700; color: #0f2a1f; }
    .ll-cart-qty { color: #6b7280; font-size: .9rem; margin-top: 4px; }
    .ll-cart-price { font-size: 1.2rem; font-weight: 900; color: #0f2a1f; }
    .ll-cart-checkout {
      display: block; width: 100%; padding: 16px; margin-top: 24px;
      background: #0d9488; color: #fff; font-weight: 800; font-size: 1.05rem;
      border: none; border-radius: 999px; cursor: pointer; text-align: center;
      text-decoration: none;
    }
    .ll-cart-checkout:hover { background: #0a7a6f; }
    .ll-cart-back { display: block; text-align: center; margin-top: 12px; color: #6b7280; font-size: .88rem; text-decoration: underline; }
  </style>
  <div class="ll-cart-wrap">
    <div class="ll-cart-title">🛍️ Your Order</div>
    {% for item in cart.items %}
      <div class="ll-cart-item">
        <div>
          <div class="ll-cart-name">{{ item.title }}</div>
          <div class="ll-cart-qty">Quantity: {{ item.quantity }}</div>
        </div>
        <div class="ll-cart-price">{{ item.final_line_price | money }}</div>
      </div>
    {% endfor %}
    <a href="/checkout" class="ll-cart-checkout">Proceed to Checkout →</a>
    <a href="/" class="ll-cart-back">← Back to store</a>
  </div>

{% else %}
  <script>
    // Cart is empty — send back to landing page
    window.location.replace('/');
  </script>
  <div style="text-align:center; padding: 100px 20px; font-family: sans-serif;">
    <h2>Your cart is empty</h2>
    <p><a href="/" style="color:#0d9488;">← Go back to choose your bundle</a></p>
  </div>
{% endif %}
