<script>
(function(){
  var variantId = document.getElementById('ll-variant-id');

  /* ── Direct-to-checkout ── */
  function bindCheckoutForm(formId, btnId){
    var form = document.getElementById(formId);
    var btn  = document.getElementById(btnId);
    if (!form || !btn) return;
    form.addEventListener('submit', function(e){
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'One moment…';
      var vid = variantId ? variantId.value : 0;
      fetch('/cart/clear.js', {method:'POST'})
        .then(function(){ return fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:vid,quantity:1})}); })
        .then(function(){ window.location.href = '/checkout'; })
        .catch(function(){ window.location.href = '/checkout'; });
    });
  }
  bindCheckoutForm('ll-hero-form',  'll-hero-btn');
  bindCheckoutForm('ll-offer-form', 'll-offer-btn');

  /* ── Gallery ── */
  var mainImg  = document.getElementById('ll-main-img');
  var thumbs   = Array.from(document.querySelectorAll('.ll-thumb'));
  var idx      = 0;

  function goTo(n){
    if (!thumbs.length || !mainImg) return;
    idx = (n + thumbs.length) % thumbs.length;
    mainImg.style.opacity = '0.35';
    setTimeout(function(){
      mainImg.src = thumbs[idx].dataset.src;
      mainImg.style.opacity = '1';
    }, 150);
    thumbs.forEach(function(t){ t.classList.remove('active'); });
    thumbs[idx].classList.add('active');
  }

  thumbs.forEach(function(t){
    t.addEventListener('click', function(){ goTo(parseInt(t.dataset.idx)); });
    t.addEventListener('keydown', function(e){ if(e.key==='Enter'||e.key===' ') goTo(parseInt(t.dataset.idx)); });
  });

  var prev = document.getElementById('ll-prev');
  var next = document.getElementById('ll-next');
  if (prev) prev.addEventListener('click', function(){ goTo(idx-1); });
  if (next) next.addEventListener('click', function(){ goTo(idx+1); });

  /* ── Accordion (objections + FAQ) ── */
  function initAccordion(selector, openClass){
    document.querySelectorAll(selector).forEach(function(item){
      var header = item.querySelector('[class$="-q"], [class$="-faq-q"]') || item.firstElementChild;
      if (!header) return;
      header.addEventListener('click', function(){
        var isOpen = item.classList.contains('open');
        document.querySelectorAll(selector).forEach(function(i){ i.classList.remove('open'); });
        if (!isOpen) item.classList.add('open');
      });
    });
  }
  initAccordion('.ll-obj');
  initAccordion('.ll-faq');

  /* ── Sticky bar ── */
  var hero   = document.getElementById('hero');
  var sticky = document.getElementById('ll-sticky');
  if (sticky && hero){
    window.addEventListener('scroll', function(){
      sticky.classList.toggle('show', hero.getBoundingClientRect().bottom < 0);
    }, {passive:true});
  }

  /* ── Smooth anchor scroll ── */
  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var id = a.getAttribute('href');
      if (id === '#') return;
      var el = document.querySelector(id);
      if (el){ e.preventDefault(); el.scrollIntoView({behavior:'smooth'}); }
    });
  });
})();
</script>
