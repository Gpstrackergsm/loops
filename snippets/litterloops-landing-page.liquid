<!-- Interactive Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Interactive Image Gallery
    const mainImg = document.getElementById('ll-main-product-image');
    const thumbBtns = document.querySelectorAll('.ll-thumb-btn');
    const prevBtn = document.getElementById('ll-gallery-prev');
    const nextBtn = document.getElementById('ll-gallery-next');
    let currentIndex = 0;

    function switchImage(index) {
      if (!thumbBtns.length || !mainImg) return;
      if (index < 0) index = thumbBtns.length - 1;
      if (index >= thumbBtns.length) index = 0;
      currentIndex = index;

      const targetBtn = thumbBtns[currentIndex];
      const newSrc = targetBtn.getAttribute('data-img-src');

      mainImg.style.opacity = '0.4';
      setTimeout(() => {
        mainImg.src = newSrc;
        mainImg.style.opacity = '1';
      }, 150);

      thumbBtns.forEach(btn => btn.classList.remove('active'));
      targetBtn.classList.add('active');
    }

    thumbBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => switchImage(idx));
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        switchImage(currentIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        switchImage(currentIndex + 1);
      });
    }

    // 2. FAQ Accordion Interaction
    const faqItems = document.querySelectorAll('.ll-faq-item');
    faqItems.forEach(item => {
      const header = item.querySelector('.ll-faq-header');
      if (header) {
        header.addEventListener('click', () => {
          const isActive = item.classList.contains('active');
          faqItems.forEach(i => i.classList.remove('active'));
          if (!isActive) item.classList.add('active');
        });
      }
    });

    // 3. Sticky Mobile Buy Bar on Scroll
    const stickyBar = document.getElementById('ll-sticky-mobile-bar');
    const heroSection = document.getElementById('hero');

    window.addEventListener('scroll', function() {
      if (!stickyBar || !heroSection) return;
      const heroBottom = heroSection.getBoundingClientRect().bottom;
      if (heroBottom < 0) {
        stickyBar.classList.add('visible');
      } else {
        stickyBar.classList.remove('visible');
      }
    });

    // 4. Smooth Anchor Scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        const targetId = this.getAttribute('href');
        if (targetId === '#') return;
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // 5. 1-Click Direct Checkout Submission
    const checkoutForm = document.getElementById('ll-direct-checkout-form');
    if (checkoutForm) {
      checkoutForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const btn = document.getElementById('ll-checkout-btn');
        if (btn) {
          btn.textContent = 'Processing...';
          btn.style.opacity = '0.85';
          btn.style.pointerEvents = 'none';
        }

        const variantId = document.getElementById('ll-variant-id').value;

        fetch('/cart/clear.js', { method: 'POST' })
          .then(() => {
            return fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: variantId, quantity: 1 })
            });
          })
          .then(res => res.json())
          .then(() => {
            window.location.href = '/checkout';
          })
          .catch(err => {
            console.error('Checkout error:', err);
            window.location.href = '/checkout';
          });
      });
    }
  });
</script>
