<script>
(function(){
  /* ── Universal Direct-to-Checkout ── */
  var fallbackVariantId = {{ vid | default: 54675654803795 }};
  var selectedQuantity = 1;

  /* ── Synchronized Bundle Selector Interactions ── */
  window.selectBundle = function(qty) {
    selectedQuantity = parseInt(qty) || 1;
    var bundleCards = document.querySelectorAll('.ll-bundle-card');
    var heroBtn     = document.getElementById('ll-hero-btn');
    var offerBtn    = document.getElementById('ll-offer-btn');

    bundleCards.forEach(function(c) {
      var cQty = parseInt(c.dataset.qty || c.getAttribute('data-qty'));
      if (cQty === selectedQuantity) {
        c.classList.add('selected');
      } else {
        c.classList.remove('selected');
      }
    });

    var hQty = document.getElementById('ll-hero-qty');
    var oQty = document.getElementById('ll-offer-qty');
    if (hQty) hQty.value = selectedQuantity;
    if (oQty) oQty.value = selectedQuantity;

    var targetCard = document.querySelector('.ll-bundle-card[data-qty="' + selectedQuantity + '"]');
    if (targetCard) {
      var price = targetCard.dataset.price || '99.99';
      var savings = targetCard.dataset.savings || '50';
      var label = 'Order ' + selectedQuantity + 'x LitterLoops™ — $' + price + ' (Save $' + savings + ')';
      if (heroBtn)  heroBtn.textContent = label;
      if (offerBtn) offerBtn.textContent = label;
    }

    var bagCount = document.getElementById('ll-bag-count');
    if (bagCount) bagCount.textContent = selectedQuantity;
  };

  var bundleCards = document.querySelectorAll('.ll-bundle-card');
  bundleCards.forEach(function(card) {
    card.addEventListener('click', function(e) {
      var qty = card.getAttribute('data-qty') || card.dataset.qty;
      window.selectBundle(qty);
    });
  });

  function goToCheckout(qty) {
    var quantity = qty || selectedQuantity || 1;
    // Read variantId at click time so it's always fresh
    var vidEl = document.getElementById('ll-vid');
    var vid = (vidEl && parseInt(vidEl.value) > 0) ? parseInt(vidEl.value) : fallbackVariantId;

    // AJAX: add selected quantity → redirect to /checkout
    // (skip cart/clear to avoid rate-limit 429 errors)
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: vid, quantity: quantity })
    })
    .then(function(res) {
      if (res.ok) {
        window.location.replace('/checkout');
      } else {
        // Fallback via cart permalink — cart.liquid will show the items and checkout button
        window.location.href = '/cart/' + vid + ':' + quantity;
      }
    })
    .catch(function() {
      window.location.href = '/cart/' + vid + ':' + quantity;
    });
  }

  // All checkout buttons (header, hero, offer, sticky, bag) — never disabled
  document.querySelectorAll('.ll-direct-checkout, #ll-hero-btn, #ll-offer-btn').forEach(function(button) {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      goToCheckout(selectedQuantity);
    });
  });

  // Hero and offer forms
  ['ll-hero-form', 'll-offer-form'].forEach(function(fid) {
    var f = document.getElementById(fid);
    if (f) {
      f.addEventListener('submit', function(e) {
        e.preventDefault();
        goToCheckout(selectedQuantity);
      });
    }
  });

  // Global interceptor for any other cart/bag clicks
  document.addEventListener('click', function(e) {
    var cartTarget = e.target.closest('a[href*="/cart"], [id*="cart"], [class*="cart"], [class*="bag"], [id*="bag"]');
    if (cartTarget && !cartTarget.classList.contains('ll-bundle-card')) {
      e.preventDefault();
      goToCheckout(selectedQuantity);
    }
  }, true);

  /* ── Gallery & Video Switcher ── */
  var videoWrap = document.getElementById('ll-video-wrap');
  var galleryVp = document.getElementById('ll-vp');
  var mainImg   = document.getElementById('ll-main-img');
  var thumbs    = Array.from(document.querySelectorAll('.ll-thumb'));
  var vidElem   = document.getElementById('ll-product-video');
  var muteBtn   = document.getElementById('ll-vid-mute');
  var pauseBtn  = document.getElementById('ll-vid-pause');
  var iconMute  = document.getElementById('ll-icon-mute');
  var iconSound = document.getElementById('ll-icon-sound');
  var iconPause = document.getElementById('ll-icon-pause');
  var iconPlay  = document.getElementById('ll-icon-play');
  var imgThumbs = thumbs.filter(function(t){ return t.dataset.type === 'image'; });
  var idx       = 0;

  function showVideoView(){
    if (videoWrap) videoWrap.style.display = 'block';
    if (galleryVp) galleryVp.style.display = 'none';
    if (vidElem) { vidElem.play(); }
    thumbs.forEach(function(t){ t.classList.remove('on'); });
    var vidThumb = document.querySelector('.ll-thumb-vid');
    if (vidThumb) vidThumb.classList.add('on');
  }

  function showImageView(imageIndex){
    if (videoWrap) {
      videoWrap.style.display = 'none';
      if (vidElem) { vidElem.pause(); }
    }
    if (galleryVp) galleryVp.style.display = 'flex';
    if (imgThumbs.length && mainImg) {
      idx = (imageIndex + imgThumbs.length) % imgThumbs.length;
      mainImg.style.opacity = '0.3';
      setTimeout(function(){
        mainImg.src = imgThumbs[idx].dataset.src;
        mainImg.style.opacity = '1';
      }, 150);
      thumbs.forEach(function(t){ t.classList.remove('on'); });
      imgThumbs[idx].classList.add('on');
    }
  }

  thumbs.forEach(function(t){
    t.addEventListener('click', function(){
      if (t.dataset.type === 'video') {
        showVideoView();
      } else {
        var imageIdx = imgThumbs.indexOf(t);
        showImageView(imageIdx >= 0 ? imageIdx : 0);
      }
    });
    t.addEventListener('keydown', function(e){
      if(e.key==='Enter'||e.key===' '){
        e.preventDefault();
        t.click();
      }
    });
  });

  var p = document.getElementById('ll-prev'), n = document.getElementById('ll-next');
  if(p) p.addEventListener('click', function(){ showImageView(idx - 1); });
  if(n) n.addEventListener('click', function(){ showImageView(idx + 1); });

  // Video controls
  if (muteBtn && vidElem) {
    muteBtn.addEventListener('click', function(e){
      e.preventDefault();
      vidElem.muted = !vidElem.muted;
      if (vidElem.muted) {
        if(iconMute) iconMute.style.display = 'none';
        if(iconSound) iconSound.style.display = 'block';
      } else {
        if(iconMute) iconMute.style.display = 'block';
        if(iconSound) iconSound.style.display = 'none';
      }
    });
  }

  if (pauseBtn && vidElem) {
    pauseBtn.addEventListener('click', function(e){
      e.preventDefault();
      if (vidElem.paused) {
        vidElem.play();
        if(iconPause) iconPause.style.display = 'block';
        if(iconPlay) iconPlay.style.display = 'none';
      } else {
        vidElem.pause();
        if(iconPause) iconPause.style.display = 'none';
        if(iconPlay) iconPlay.style.display = 'block';
      }
    });
  }

  /* ── Accordions (objections + FAQ) ── */
  function initAcc(sel){
    document.querySelectorAll(sel).forEach(function(item){
      var q = item.querySelector('[class$="-q"]') || item.firstElementChild;
      if(!q) return;
      var icon = item.querySelector('.ll-obj-icon');
      q.addEventListener('click', function(){
        var open = item.classList.contains('on');
        document.querySelectorAll(sel).forEach(function(i){
          i.classList.remove('on');
          var ic = i.querySelector('.ll-obj-icon');
          if(ic) ic.textContent = '+';
        });
        if(!open){
          item.classList.add('on');
          if(icon) icon.textContent = '−';
        }
      });
    });
  }
  initAcc('.ll-obj');
  // FAQ uses chevron SVG (no text icon)
  document.querySelectorAll('.ll-faq').forEach(function(item){
    var q = item.querySelector('.ll-faq-q');
    if(!q) return;
    q.addEventListener('click', function(){
      var open = item.classList.contains('on');
      document.querySelectorAll('.ll-faq').forEach(function(i){ i.classList.remove('on'); });
      if(!open) item.classList.add('on');
    });
  });

  /* ── Sticky bar ── */
  var hero   = document.getElementById('hero');
  var sticky = document.getElementById('ll-sticky');
  if(sticky&&hero){
    window.addEventListener('scroll', function(){
      sticky.classList.toggle('show', hero.getBoundingClientRect().bottom < 0);
    },{passive:true});
  }

  /* ── Dynamic Client-Side Video Auto-Discovery ── */
  function autoDiscoverVideo() {
    if (vidElem || (videoWrap && videoWrap.querySelector('video, iframe'))) {
      return; // Video already rendered by server
    }
    var container = document.getElementById('ll-gallery-container');
    var handle = container ? container.getAttribute('data-product-handle') : '';
    var candidates = [
      handle ? '/products/' + handle + '.js' : null,
      '/products/litterloops-non-electric-self-cleaning-cat-litter-box.js',
      '/products/litterloops.js',
      '/collections/all/products.json'
    ].filter(Boolean);

    function tryFetch(urls) {
      if (!urls.length) return;
      var url = urls.shift();
      fetch(url)
        .then(function(res){ return res.json(); })
        .then(function(data){
          var mediaList = data.media || (data.products && data.products[0] && data.products[0].media);
          if (!mediaList && data.images && data.images.length) {
            // Check if any media in data
          }
          if (mediaList && mediaList.length) {
            var foundVid = mediaList.find(function(m){ return m.media_type === 'video' || m.media_type === 'external_video'; });
            if (foundVid && videoWrap) {
              if (foundVid.media_type === 'video' && foundVid.sources && foundVid.sources.length) {
                var mp4Source = foundVid.sources.find(function(s){ return s.format === 'mp4' || s.mime_type === 'video/mp4'; }) || foundVid.sources[0];
                var v = document.createElement('video');
                v.id = 'll-product-video';
                v.className = 'll-video';
                v.autoplay = true;
                v.muted = true;
                v.loop = true;
                v.setAttribute('playsinline', '');
                v.setAttribute('preload', 'auto');
                v.src = mp4Source.url;
                videoWrap.insertBefore(v, videoWrap.firstChild);
                vidElem = v;
                showVideoView();
              } else if (foundVid.media_type === 'external_video') {
                var iframe = document.createElement('iframe');
                iframe.className = 'll-video';
                iframe.src = 'https://www.youtube.com/embed/' + foundVid.external_id + '?autoplay=1&mute=1&loop=1&playlist=' + foundVid.external_id;
                iframe.setAttribute('allow', 'autoplay; encrypted-media');
                iframe.setAttribute('allowfullscreen', '');
                videoWrap.insertBefore(iframe, videoWrap.firstChild);
                showVideoView();
              }
            }
          } else {
            tryFetch(urls);
          }
        })
        .catch(function(){
          tryFetch(urls);
        });
    }
    tryFetch(candidates);
  }
  autoDiscoverVideo();
})();
</script>
