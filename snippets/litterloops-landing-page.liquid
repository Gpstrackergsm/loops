{% comment %}
  LitterLoops™ Landing Page — Premium Pet Brand Edition
  Conversion Order: Product → How It Works → Why Different → Benefits → Objections → Specs → Price → FAQ → CTA
{% endcomment %}

{%- liquid
  assign current_product = product
  if current_product == nil or current_product == blank
    assign current_product = all_products['litterloops-non-electric-self-cleaning-cat-litter-box']
  endif
  if current_product == nil or current_product == blank
    assign current_product = all_products['litterloops']
  endif
  if current_product == nil or current_product == blank
    assign current_product = collections.frontpage.products.first
  endif
  if current_product == nil or current_product == blank
    assign current_product = collections.all.products.first
  endif
  assign current_variant = current_product.selected_or_first_available_variant
  assign variant_id = current_variant.id | default: 0
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">

<style>
/* ─── TOKENS ─────────────────────────────────────────────────── */
:root {
  --c-brand:        #0a7c71;
  --c-brand-mid:    #0d9488;
  --c-brand-light:  #f0fdf9;
  --c-brand-border: #b2f0e8;

  --c-ink:          #0f1923;
  --c-ink-soft:     #2d3d4d;
  --c-muted:        #64748b;
  --c-subtle:       #94a3b8;

  --c-surface:      #ffffff;
  --c-wash:         #f8fafc;
  --c-line:         #e8edf2;

  --c-green-bg:     #dcfce7;
  --c-green-text:   #15803d;
  --c-amber:        #d97706;
  --c-amber-bg:     #fffbeb;

  --f-head: 'Manrope', system-ui, sans-serif;
  --f-body: 'Inter', system-ui, sans-serif;

  --r-sm:   6px;
  --r-md:   12px;
  --r-lg:   18px;
  --r-xl:   24px;
  --r-pill: 999px;

  --sh-card: 0 2px 12px rgba(15,25,35,.06), 0 1px 3px rgba(15,25,35,.04);
  --sh-lift: 0 8px 28px rgba(15,25,35,.10), 0 2px 6px rgba(15,25,35,.05);
}

/* ─── RESET ──────────────────────────────────────────────────── */
.ll * { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }
.ll { font-family: var(--f-body); font-size: 16px; color: var(--c-ink-soft); line-height: 1.6; background: var(--c-surface); overflow-x: hidden; }

/* ─── LAYOUT ─────────────────────────────────────────────────── */
.ll-wrap  { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
.ll-narrow { max-width: 780px;  margin: 0 auto; padding: 0 20px; }
.ll-sec  { padding: 80px 0; }
.ll-sec-alt { background: var(--c-wash); }
@media(max-width:767px){ .ll-sec { padding: 56px 0; } }

/* ─── TYPE ───────────────────────────────────────────────────── */
.ll h1,.ll h2,.ll h3,.ll h4 { font-family: var(--f-head); color: var(--c-ink); line-height: 1.18; letter-spacing: -.025em; }
.ll h1 { font-size: clamp(2.25rem, 5vw, 3.6rem); font-weight: 800; letter-spacing: -.035em; }
.ll h2 { font-size: clamp(1.75rem, 3.2vw, 2.5rem); font-weight: 800; }
.ll h3 { font-size: 1.2rem; font-weight: 700; }
.ll h4 { font-size: 1rem; font-weight: 600; }
.ll-kicker {
  display: inline-block;
  font-family: var(--f-head);
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .10em;
  text-transform: uppercase;
  color: var(--c-brand);
  margin-bottom: 14px;
}
.ll-lede { font-size: 1.1rem; color: var(--c-muted); margin-top: 12px; line-height: 1.65; }

/* ─── BUTTONS ────────────────────────────────────────────────── */
.ll-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  font-family: var(--f-head); font-weight: 700; font-size: .98rem;
  padding: 15px 30px; border-radius: var(--r-pill);
  border: 2px solid transparent; cursor: pointer; text-decoration: none;
  transition: all .18s ease; white-space: nowrap; letter-spacing: -.01em;
}
.ll-btn-primary {
  background: var(--c-brand); color: #fff;
  box-shadow: 0 4px 18px rgba(10,124,113,.28);
}
.ll-btn-primary:hover { background: #086860; box-shadow: 0 6px 24px rgba(10,124,113,.36); transform: translateY(-1px); }
.ll-btn-ghost {
  background: transparent; color: var(--c-ink);
  border-color: var(--c-line);
}
.ll-btn-ghost:hover { border-color: var(--c-brand); color: var(--c-brand); }
.ll-btn-full { width: 100%; padding: 17px; font-size: 1.05rem; }
.ll-btn-lg { padding: 18px 40px; font-size: 1.1rem; }

/* ─── HEADER ─────────────────────────────────────────────────── */
.ll-header {
  position: sticky; top: 0; z-index: 200;
  background: rgba(255,255,255,.96); backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--c-line);
}
.ll-header-inner {
  display: flex; align-items: center; justify-content: space-between;
  height: 62px;
}
.ll-logo {
  font-family: var(--f-head); font-size: 1.35rem; font-weight: 800;
  color: var(--c-ink); text-decoration: none; letter-spacing: -.04em;
}
.ll-logo span { color: var(--c-brand); }
.ll-header-nav { display: none; gap: 28px; }
.ll-header-nav a { font-size: .9rem; font-weight: 600; color: var(--c-muted); text-decoration: none; transition: color .15s; }
.ll-header-nav a:hover { color: var(--c-brand); }
@media(min-width:900px){ .ll-header-nav { display: flex; } }

/* ─── HERO ───────────────────────────────────────────────────── */
.ll-hero {
  padding: 52px 0 68px;
  background: linear-gradient(160deg, #f0fdf9 0%, var(--c-surface) 55%);
}
.ll-hero-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
  align-items: center;
}
@media(min-width:900px){
  .ll-hero-grid { grid-template-columns: 52% 1fr; gap: 60px; }
}

/* Gallery */
.ll-gallery {
  background: var(--c-surface);
  border: 1px solid var(--c-line);
  border-radius: var(--r-xl);
  padding: 18px;
  box-shadow: var(--sh-lift);
}
.ll-gallery-main {
  position: relative;
  background: linear-gradient(145deg, #f0fdf9 0%, #f8fafc 100%);
  border-radius: var(--r-lg);
  overflow: hidden;
  aspect-ratio: 4/3;
  display: flex; align-items: center; justify-content: center;
}
.ll-gallery-main img {
  width: 100%; height: 100%; object-fit: contain;
  transition: opacity .2s ease;
}
.ll-gallery-arrow {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 38px; height: 38px; border-radius: 50%;
  background: rgba(255,255,255,.92); border: 1px solid var(--c-line);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; box-shadow: var(--sh-card);
  color: var(--c-ink); transition: all .15s;
}
.ll-gallery-arrow:hover { background: var(--c-brand); color: #fff; border-color: var(--c-brand); }
.ll-gallery-arrow.prev { left: 10px; }
.ll-gallery-arrow.next { right: 10px; }
.ll-gallery-dots {
  display: flex; gap: 8px; justify-content: center;
  margin-top: 14px; padding-bottom: 2px;
}
.ll-thumb {
  width: 64px; height: 64px; border-radius: var(--r-sm);
  border: 2px solid transparent; cursor: pointer; overflow: hidden;
  background: var(--c-wash); flex-shrink: 0; transition: border-color .15s;
}
.ll-thumb img { width: 100%; height: 100%; object-fit: cover; }
.ll-thumb.active { border-color: var(--c-brand); }

/* Gallery placeholder SVG */
.ll-gallery-placeholder {
  display: flex; flex-direction: column; align-items: center; gap: 20px;
  padding: 40px;
}
.ll-gallery-placeholder svg { opacity: .8; }
.ll-gallery-placeholder p {
  font-size: .85rem; color: var(--c-subtle); text-align: center;
}

/* Hero copy */
.ll-hero-copy { display: flex; flex-direction: column; gap: 20px; }
.ll-hero-tag {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--f-head); font-size: .82rem; font-weight: 700;
  color: var(--c-brand); background: var(--c-brand-light);
  border: 1px solid var(--c-brand-border);
  padding: 6px 14px; border-radius: var(--r-pill); width: fit-content;
}
.ll-hero-sub { font-size: 1.15rem; color: var(--c-muted); line-height: 1.6; }
.ll-mini-checks {
  display: flex; flex-wrap: wrap; gap: 10px 16px;
}
.ll-mini-check {
  display: flex; align-items: center; gap: 7px;
  font-size: .88rem; font-weight: 600; color: var(--c-ink-soft);
}
.ll-mini-check::before { content: '✓'; color: var(--c-brand); font-weight: 800; font-size: .9rem; }
.ll-price-row {
  display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
  padding: 4px 0;
}
.ll-price { font-family: var(--f-head); font-size: 2.4rem; font-weight: 800; color: var(--c-ink); line-height: 1; }
.ll-price-was { font-size: 1.15rem; color: var(--c-subtle); text-decoration: line-through; }
.ll-price-save {
  font-size: .82rem; font-weight: 700; color: var(--c-green-text);
  background: var(--c-green-bg); padding: 4px 10px; border-radius: var(--r-pill);
}
.ll-cta-row { display: flex; gap: 12px; flex-wrap: wrap; }

/* ─── MECHANISM STRIP ────────────────────────────────────────── */
.ll-mech {
  background: var(--c-ink);
  padding: 22px 0;
}
.ll-mech-inner {
  display: flex; align-items: center; justify-content: center;
  gap: 0; flex-wrap: wrap;
}
.ll-mech-step {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 24px;
}
.ll-mech-step-num {
  font-family: var(--f-head); font-size: .72rem; font-weight: 700;
  color: var(--c-brand-mid); letter-spacing: .08em;
}
.ll-mech-step-label {
  font-family: var(--f-head); font-size: 1rem; font-weight: 700;
  color: #fff; letter-spacing: -.01em;
}
.ll-mech-arrow { color: #334155; font-size: 1.2rem; padding: 0 4px; }
@media(max-width:600px){
  .ll-mech-step { padding: 10px 16px; }
  .ll-mech-arrow { display: none; }
}

/* ─── EXPLAIN ────────────────────────────────────────────────── */
.ll-explain-grid {
  display: grid; grid-template-columns: 1fr;
  gap: 40px; align-items: center;
}
@media(min-width:900px){
  .ll-explain-grid { grid-template-columns: 1fr 1fr; gap: 60px; }
}
.ll-explain-img {
  border-radius: var(--r-xl); overflow: hidden;
  background: var(--c-wash); aspect-ratio: 1;
  display: flex; align-items: center; justify-content: center;
  border: 1px solid var(--c-line);
}
.ll-explain-img img { width: 100%; height: 100%; object-fit: contain; }
.ll-explain-copy { display: flex; flex-direction: column; gap: 20px; }
.ll-explain-copy p { color: var(--c-muted); font-size: 1.05rem; line-height: 1.7; }

/* ─── HOW IT WORKS ───────────────────────────────────────────── */
.ll-steps {
  display: grid; grid-template-columns: 1fr;
  gap: 24px;
}
@media(min-width:768px){
  .ll-steps { grid-template-columns: repeat(3,1fr); }
}
.ll-step {
  background: var(--c-surface); border: 1px solid var(--c-line);
  border-radius: var(--r-xl); padding: 32px 26px;
  box-shadow: var(--sh-card);
  display: flex; flex-direction: column; gap: 14px;
  position: relative; overflow: hidden;
}
.ll-step::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--c-brand-mid);
}
.ll-step-badge {
  font-family: var(--f-head); font-size: .75rem; font-weight: 800;
  letter-spacing: .08em; color: var(--c-brand);
  background: var(--c-brand-light); border: 1px solid var(--c-brand-border);
  padding: 4px 12px; border-radius: var(--r-pill); width: fit-content;
}
.ll-step h3 { font-size: 1.3rem; margin-top: 4px; }
.ll-step p { font-size: .95rem; color: var(--c-muted); line-height: 1.6; }
.ll-step-img {
  width: 100%; aspect-ratio: 4/3; border-radius: var(--r-md);
  object-fit: cover; background: var(--c-wash);
  margin-top: 8px; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.ll-step-img img { width: 100%; height: 100%; object-fit: contain; }

/* ─── BENEFITS GRID ──────────────────────────────────────────── */
.ll-benefits {
  display: grid; grid-template-columns: 1fr;
  gap: 18px;
}
@media(min-width:600px){ .ll-benefits { grid-template-columns: repeat(2,1fr); } }
@media(min-width:900px){ .ll-benefits { grid-template-columns: repeat(3,1fr); } }
.ll-benefit {
  background: var(--c-surface); border: 1px solid var(--c-line);
  border-radius: var(--r-lg); padding: 26px 22px;
  display: flex; flex-direction: column; gap: 10px;
}
.ll-benefit-icon {
  width: 44px; height: 44px; border-radius: var(--r-md);
  background: var(--c-brand-light); border: 1px solid var(--c-brand-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.25rem;
}
.ll-benefit h3 { font-size: 1.05rem; }
.ll-benefit p { font-size: .9rem; color: var(--c-muted); line-height: 1.55; }

/* ─── OBJECTIONS ─────────────────────────────────────────────── */
.ll-obj-grid {
  display: flex; flex-direction: column; gap: 14px;
}
.ll-obj {
  background: var(--c-surface); border: 1px solid var(--c-line);
  border-radius: var(--r-lg); overflow: hidden;
  transition: border-color .15s;
}
.ll-obj.open { border-color: var(--c-brand-mid); }
.ll-obj-q {
  padding: 20px 22px; display: flex; align-items: center; justify-content: space-between;
  gap: 16px; cursor: pointer; user-select: none;
}
.ll-obj-q span {
  font-family: var(--f-head); font-size: 1rem; font-weight: 700; color: var(--c-ink);
  line-height: 1.3;
}
.ll-obj-icon {
  width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
  background: var(--c-wash); border: 1px solid var(--c-line);
  display: flex; align-items: center; justify-content: center;
  color: var(--c-muted); transition: all .15s;
}
.ll-obj.open .ll-obj-icon { background: var(--c-brand); color: #fff; border-color: var(--c-brand); transform: rotate(45deg); }
.ll-obj-a {
  display: none; padding: 0 22px 20px;
  font-size: .95rem; color: var(--c-muted); line-height: 1.65;
}
.ll-obj.open .ll-obj-a { display: block; }

/* ─── COMPETITOR SECTION ─────────────────────────────────────── */
.ll-dark-card {
  background: var(--c-ink);
  border-radius: var(--r-xl);
  padding: 56px 40px;
  text-align: center;
  max-width: 860px; margin: 0 auto;
}
.ll-dark-card .ll-kicker { color: var(--c-brand-mid); }
.ll-dark-card h2 { color: #fff; margin-bottom: 16px; }
.ll-dark-card p { color: #94a3b8; font-size: 1.05rem; line-height: 1.7; max-width: 600px; margin: 0 auto; }
.ll-no-list {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: 10px; margin-top: 28px;
}
.ll-no-pill {
  font-family: var(--f-head); font-size: .88rem; font-weight: 700;
  color: #fff; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15);
  padding: 8px 18px; border-radius: var(--r-pill);
}
@media(max-width:600px){
  .ll-dark-card { padding: 40px 22px; }
}

/* ─── SPEC TABLE ─────────────────────────────────────────────── */
.ll-spec-wrap {
  background: var(--c-surface);
  border: 1px solid var(--c-line);
  border-radius: var(--r-xl);
  overflow: hidden;
  box-shadow: var(--sh-card);
}
.ll-spec-table { width: 100%; border-collapse: collapse; }
.ll-spec-table tr { border-bottom: 1px solid var(--c-line); }
.ll-spec-table tr:last-child { border-bottom: none; }
.ll-spec-table td { padding: 15px 22px; font-size: .95rem; vertical-align: top; }
.ll-spec-table td:first-child {
  font-family: var(--f-head); font-weight: 700; color: var(--c-ink);
  background: var(--c-wash); width: 40%;
}
.ll-spec-table td:last-child { color: var(--c-ink-soft); }

/* ─── INCLUDED ───────────────────────────────────────────────── */
.ll-included-list {
  display: grid; grid-template-columns: 1fr;
  gap: 12px;
}
@media(min-width:600px){ .ll-included-list { grid-template-columns: repeat(2,1fr); } }
.ll-included-item {
  display: flex; align-items: flex-start; gap: 14px;
  background: var(--c-surface); border: 1px solid var(--c-line);
  border-radius: var(--r-md); padding: 16px 18px;
}
.ll-included-check {
  width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
  background: var(--c-brand-light); border: 1px solid var(--c-brand-border);
  display: flex; align-items: center; justify-content: center;
  color: var(--c-brand); font-size: .8rem; font-weight: 800;
}
.ll-included-item span { font-size: .95rem; font-weight: 600; color: var(--c-ink-soft); line-height: 1.4; }

/* ─── OFFER ──────────────────────────────────────────────────── */
.ll-offer-card {
  max-width: 580px; margin: 0 auto;
  background: var(--c-surface);
  border: 2px solid var(--c-brand-border);
  border-radius: var(--r-xl);
  padding: 40px 32px;
  box-shadow: 0 4px 32px rgba(10,124,113,.10);
  text-align: center;
}
.ll-offer-product-name {
  font-family: var(--f-head); font-size: 1.5rem; font-weight: 800;
  color: var(--c-ink); letter-spacing: -.03em; margin-bottom: 4px;
}
.ll-offer-sub { font-size: .9rem; color: var(--c-muted); margin-bottom: 16px; }
.ll-offer-price-row {
  display: flex; align-items: baseline; justify-content: center;
  gap: 14px; margin-bottom: 24px; flex-wrap: wrap;
}
.ll-offer-price { font-family: var(--f-head); font-size: 3.2rem; font-weight: 800; color: var(--c-ink); line-height: 1; }
.ll-offer-was { font-size: 1.4rem; color: var(--c-subtle); text-decoration: line-through; }
.ll-trust-row {
  display: flex; justify-content: center; flex-wrap: wrap;
  gap: 8px 20px; margin-top: 18px;
}
.ll-trust-item {
  display: flex; align-items: center; gap: 6px;
  font-size: .82rem; font-weight: 600; color: var(--c-muted);
}
.ll-trust-icon { font-size: .9rem; }

/* ─── TRUST SECTION ──────────────────────────────────────────── */
.ll-trust-grid {
  display: grid; grid-template-columns: repeat(2,1fr);
  gap: 14px;
}
@media(min-width:600px){ .ll-trust-grid { grid-template-columns: repeat(4,1fr); } }
.ll-trust-card {
  background: var(--c-surface); border: 1px solid var(--c-line);
  border-radius: var(--r-lg); padding: 22px 16px;
  text-align: center; display: flex; flex-direction: column; gap: 10px; align-items: center;
}
.ll-trust-card-icon { font-size: 1.6rem; }
.ll-trust-card h4 { font-size: .95rem; }
.ll-trust-card p { font-size: .85rem; color: var(--c-muted); line-height: 1.45; }

/* ─── FAQ ────────────────────────────────────────────────────── */
.ll-faq-list { display: flex; flex-direction: column; gap: 10px; }
.ll-faq {
  background: var(--c-surface); border: 1px solid var(--c-line);
  border-radius: var(--r-md); overflow: hidden;
  transition: border-color .15s;
}
.ll-faq.open { border-color: var(--c-brand-mid); }
.ll-faq-q {
  padding: 18px 20px; display: flex; align-items: center;
  justify-content: space-between; gap: 16px;
  cursor: pointer; user-select: none;
}
.ll-faq-q span { font-family: var(--f-head); font-size: .98rem; font-weight: 700; color: var(--c-ink); }
.ll-faq-chevron {
  width: 22px; height: 22px; flex-shrink: 0;
  color: var(--c-muted); transition: transform .15s;
}
.ll-faq.open .ll-faq-chevron { transform: rotate(180deg); color: var(--c-brand); }
.ll-faq-a {
  display: none; padding: 0 20px 18px;
  font-size: .93rem; color: var(--c-muted); line-height: 1.65;
}
.ll-faq.open .ll-faq-a { display: block; }

/* ─── FINAL CTA ──────────────────────────────────────────────── */
.ll-final { text-align: center; }
.ll-final h2 { margin-bottom: 12px; }
.ll-final p { font-size: 1.1rem; color: var(--c-muted); margin-bottom: 28px; }

/* ─── FOOTER ─────────────────────────────────────────────────── */
.ll-footer {
  padding: 32px 0; border-top: 1px solid var(--c-line);
  text-align: center; color: var(--c-subtle); font-size: .82rem;
}

/* ─── STICKY BAR ─────────────────────────────────────────────── */
.ll-sticky {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;
  background: rgba(255,255,255,.96); backdrop-filter: blur(12px);
  border-top: 1px solid var(--c-line);
  padding: 12px 20px;
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  transform: translateY(120%); transition: transform .25s ease;
  box-shadow: 0 -4px 20px rgba(15,25,35,.08);
}
.ll-sticky.show { transform: translateY(0); }
.ll-sticky-info { display: flex; flex-direction: column; gap: 1px; }
.ll-sticky-name { font-family: var(--f-head); font-size: .88rem; font-weight: 800; color: var(--c-ink); }
.ll-sticky-price { font-family: var(--f-head); font-size: 1.1rem; font-weight: 800; color: var(--c-brand); }

/* ─── SECTION HEADING UTILITY ────────────────────────────────── */
.ll-sec-head { margin-bottom: 44px; }
.ll-sec-head.center { text-align: center; }
