{% comment %}
  =============================================================================
  LitterLoops™ — Official Product Landing Page
  Positioning: Premium, Honest, Non-Electric Cat Care Design
  =============================================================================
{% endcomment %}

{%- liquid
  assign current_product = product
  if current_product == nil
    if all_products['litterloops-non-electric-self-cleaning-cat-litter-box'] != blank
      assign current_product = all_products['litterloops-non-electric-self-cleaning-cat-litter-box']
    elsif all_products['litterloops™-non-electric-self-cleaning-cat-litter-box'] != blank
      assign current_product = all_products['litterloops™-non-electric-self-cleaning-cat-litter-box']
    elsif all_products['litterloops'] != blank
      assign current_product = all_products['litterloops']
    elsif collections.frontpage.products.first != blank
      assign current_product = collections.frontpage.products.first
    elsif collections['home-page'].products.first != blank
      assign current_product = collections['home-page'].products.first
    elsif collections.all.products.first != blank
      assign current_product = collections.all.products.first
    endif
  endif

  assign current_variant = current_product.selected_or_first_available_variant
  assign variant_id = current_variant.id | default: 1
  assign price_display = "$99.99"
  assign compare_price_display = "$149.99"
  assign savings_display = "$50.00"
-%}

<!-- Typography -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --ll-font-heading: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --ll-font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    
    /* Clean Premium Pet Brand Palette */
    --ll-primary: #0d9488;
    --ll-primary-hover: #0f766e;
    --ll-primary-light: #f0fdfa;
    --ll-primary-border: #ccfbf1;
    
    --ll-dark: #0f172a;
    --ll-dark-soft: #1e293b;
    --ll-text-body: #334155;
    --ll-muted: #64748b;
    --ll-border: #e2e8f0;
    --ll-border-subtle: #f1f5f9;
    
    --ll-bg-pure: #ffffff;
    --ll-bg-surface: #f8fafc;
    --ll-bg-warm: #f1f5f9;
    
    --ll-success: #059669;
    --ll-accent: #d97706;
    --ll-accent-bg: #fef3c7;
    
    --ll-shadow-subtle: 0 1px 3px 0 rgba(15, 23, 42, 0.04), 0 1px 2px -1px rgba(15, 23, 42, 0.03);
    --ll-shadow-card: 0 4px 12px -2px rgba(15, 23, 42, 0.05), 0 2px 4px -2px rgba(15, 23, 42, 0.03);
    --ll-shadow-elevated: 0 20px 30px -10px rgba(15, 23, 42, 0.08);
    
    --ll-radius-sm: 8px;
    --ll-radius-md: 12px;
    --ll-radius-lg: 18px;
    --ll-radius-xl: 24px;
    --ll-radius-full: 9999px;
  }

  /* Reset & Baseline */
  .ll-page * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  .ll-page {
    font-family: var(--ll-font-body);
    color: var(--ll-text-body);
    background-color: var(--ll-bg-pure);
    line-height: 1.6;
    font-size: 16px;
    overflow-x: hidden;
  }

  .ll-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .ll-container-narrow {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Typography */
  .ll-h1, .ll-h2, .ll-h3, .ll-h4 {
    font-family: var(--ll-font-heading);
    color: var(--ll-dark);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .ll-h1 { font-size: clamp(2.3rem, 4.2vw, 3.4rem); letter-spacing: -0.03em; }
  .ll-h2 { font-size: clamp(1.8rem, 3.2vw, 2.5rem); }
  .ll-h3 { font-size: clamp(1.2rem, 1.8vw, 1.45rem); font-weight: 700; }
  .ll-h4 { font-size: 1.1rem; font-weight: 600; }

  /* Buttons */
  .ll-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--ll-font-heading);
    font-weight: 600;
    font-size: 1.05rem;
    padding: 16px 32px;
    border-radius: var(--ll-radius-full);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .ll-btn-primary {
    background-color: var(--ll-primary);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(13, 148, 136, 0.25);
  }

  .ll-btn-primary:hover {
    background-color: var(--ll-primary-hover);
    box-shadow: 0 6px 20px rgba(13, 148, 136, 0.32);
    transform: translateY(-1px);
  }

  .ll-btn-secondary {
    background-color: var(--ll-bg-surface);
    color: var(--ll-dark);
    border-color: var(--ll-border);
  }

  .ll-btn-secondary:hover {
    background-color: #ffffff;
    border-color: var(--ll-primary);
    color: var(--ll-primary);
  }

  .ll-btn-block {
    width: 100%;
    padding: 18px;
    font-size: 1.15rem;
  }

  .ll-btn-sm {
    padding: 10px 22px;
    font-size: 0.95rem;
  }

  .ll-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--ll-radius-full);
    background: var(--ll-bg-surface);
    color: var(--ll-dark-soft);
    border: 1px solid var(--ll-border);
  }

  /* Header */
  .ll-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--ll-border);
  }

  .ll-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
  }

  .ll-brand {
    font-family: var(--ll-font-heading);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--ll-dark);
    text-decoration: none;
    letter-spacing: -0.03em;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ll-brand span {
    color: var(--ll-primary);
  }

  .ll-header-nav {
    display: none;
    align-items: center;
    gap: 24px;
  }

  .ll-header-nav a {
    color: var(--ll-muted);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .ll-header-nav a:hover {
    color: var(--ll-primary);
  }

  @media (min-width: 768px) {
    .ll-header-nav {
      display: flex;
    }
  }

  /* Section Styling */
  .ll-section {
    padding: 72px 0;
  }

  .ll-section-alt {
    background-color: var(--ll-bg-surface);
  }

  .ll-section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 48px;
  }

  .ll-section-kicker {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ll-primary);
    margin-bottom: 8px;
  }

  .ll-section-subtitle {
    font-size: 1.1rem;
    color: var(--ll-muted);
    margin-top: 12px;
  }

  /* SECTION 1: HERO */
  .ll-hero {
    padding: 48px 0 64px;
    background: radial-gradient(circle at top right, rgba(204, 251, 241, 0.4) 0%, rgba(255, 255, 255, 1) 60%);
  }

  .ll-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 992px) {
    .ll-hero-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 56px;
    }
  }

  /* Hero Gallery */
  .ll-gallery-card {
    background: var(--ll-bg-pure);
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-xl);
    padding: 20px;
    box-shadow: var(--ll-shadow-card);
  }

  .ll-gallery-viewport {
    width: 100%;
    height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, #f0fdfa 0%, #f8fafc 100%);
    border-radius: var(--ll-radius-lg);
    position: relative;
    overflow: hidden;
  }

  .ll-gallery-main-img {
    max-width: 100%;
    max-height: 390px;
    object-fit: contain;
    border-radius: var(--ll-radius-md);
    transition: opacity 0.2s ease;
  }

  .ll-gallery-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid var(--ll-border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s ease;
    box-shadow: var(--ll-shadow-subtle);
    color: var(--ll-dark);
  }

  .ll-gallery-nav-btn:hover {
    background: var(--ll-primary);
    color: #ffffff;
  }

  .ll-gallery-nav-prev { left: 12px; }
  .ll-gallery-nav-next { right: 12px; }

  .ll-thumbnails {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .ll-thumb-btn {
    width: 68px;
    height: 68px;
    border-radius: var(--ll-radius-md);
    border: 2px solid transparent;
    padding: 2px;
    background: var(--ll-bg-surface);
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.2s ease;
  }

  .ll-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }

  .ll-thumb-btn.active {
    border-color: var(--ll-primary);
  }

  /* Hero Content */
  .ll-hero-content {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .ll-hero-subheadline {
    font-size: 1.15rem;
    color: var(--ll-muted);
    line-height: 1.55;
  }

  .ll-hero-pricing {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0 6px;
  }

  .ll-price-main {
    font-family: var(--ll-font-heading);
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--ll-dark);
  }

  .ll-price-compare {
    font-size: 1.2rem;
    color: var(--ll-muted);
    text-decoration: line-through;
  }

  .ll-price-badge {
    font-size: 0.85rem;
    font-weight: 700;
    color: #15803d;
    background: #dcfce7;
    padding: 4px 10px;
    border-radius: var(--ll-radius-full);
  }

  .ll-hero-cta-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 480px) {
    .ll-hero-cta-group {
      flex-direction: row;
      align-items: center;
    }
  }

  .ll-hero-guarantees {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.82rem;
    color: var(--ll-muted);
    margin-top: 4px;
  }

  /* SECTION 2: THE PROBLEM */
  .ll-problem-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .ll-problem-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ll-problem-card {
    background: var(--ll-bg-surface);
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-lg);
    padding: 28px 24px;
    text-align: center;
  }

  .ll-problem-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #fee2e2;
    color: #b91c1c;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    font-size: 1.3rem;
  }

  .ll-problem-intro {
    text-align: center;
    margin-top: 36px;
    padding: 18px 24px;
    background: var(--ll-primary-light);
    border: 1px solid var(--ll-primary-border);
    border-radius: var(--ll-radius-lg);
    font-family: var(--ll-font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ll-primary-hover);
  }

  /* SECTION 3: HOW IT WORKS */
  .ll-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .ll-steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ll-step-card {
    background: #ffffff;
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-xl);
    padding: 32px 24px;
    box-shadow: var(--ll-shadow-card);
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
  }

  .ll-step-num {
    font-family: var(--ll-font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--ll-primary);
    background: var(--ll-primary-light);
    width: fit-content;
    padding: 4px 12px;
    border-radius: var(--ll-radius-full);
  }

  .ll-step-card h3 {
    font-size: 1.3rem;
  }

  .ll-step-card p {
    color: var(--ll-muted);
    font-size: 0.95rem;
  }

  /* SECTION 4: WHY NON-ELECTRIC (COMPARISON) */
  .ll-compare-box {
    background: #ffffff;
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-xl);
    padding: 36px 30px;
    box-shadow: var(--ll-shadow-card);
  }

  .ll-checklist-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: 28px 0;
  }

  @media (min-width: 768px) {
    .ll-checklist-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px 32px;
    }
  }

  .ll-check-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    color: var(--ll-dark-soft);
  }

  .ll-check-bullet {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #dcfce7;
    color: #15803d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .ll-positioning-quote {
    background: var(--ll-bg-surface);
    border-left: 4px solid var(--ll-primary);
    padding: 16px 20px;
    border-radius: 0 var(--ll-radius-md) var(--ll-radius-md) 0;
    font-size: 1.05rem;
    color: var(--ll-dark-soft);
    font-weight: 500;
  }

  /* SECTION 5 & 11: OBJECTIONS & FAQ ACCORDION */
  .ll-faq-stack {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ll-faq-item {
    background: #ffffff;
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-lg);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .ll-faq-item.active {
    border-color: var(--ll-primary);
    box-shadow: var(--ll-shadow-subtle);
  }

  .ll-faq-header {
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-family: var(--ll-font-heading);
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--ll-dark);
    user-select: none;
  }

  .ll-faq-icon {
    width: 20px;
    height: 20px;
    color: var(--ll-primary);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .ll-faq-item.active .ll-faq-icon {
    transform: rotate(180deg);
  }

  .ll-faq-body {
    padding: 0 24px 22px;
    font-size: 0.98rem;
    color: var(--ll-muted);
    line-height: 1.65;
    display: none;
  }

  .ll-faq-item.active .ll-faq-body {
    display: block;
  }

  /* SECTION 6: BENEFITS GRID */
  .ll-benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .ll-benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .ll-benefits-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ll-benefit-card {
    background: #ffffff;
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-lg);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ll-benefit-icon {
    font-size: 1.8rem;
    margin-bottom: 4px;
  }

  .ll-benefit-card h3 {
    font-size: 1.15rem;
    color: var(--ll-dark);
  }

  .ll-benefit-card p {
    font-size: 0.92rem;
    color: var(--ll-muted);
  }

  /* SECTION 7: NOT EVERY CAT LOVES A ROBOT */
  .ll-cat-card {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: var(--ll-radius-xl);
    padding: 48px 36px;
    color: #ffffff;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .ll-cat-card h2 {
    color: #ffffff;
    margin-bottom: 16px;
  }

  .ll-cat-card p {
    color: #94a3b8;
    font-size: 1.1rem;
    line-height: 1.65;
  }

  /* SECTION 8: PRODUCT DETAILS / SPECS TABLE */
  .ll-specs-table-wrap {
    background: #ffffff;
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-xl);
    overflow: hidden;
    box-shadow: var(--ll-shadow-card);
  }

  .ll-specs-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .ll-specs-table tr {
    border-bottom: 1px solid var(--ll-border);
  }

  .ll-specs-table tr:last-child {
    border-bottom: none;
  }

  .ll-specs-table td {
    padding: 16px 24px;
    font-size: 0.95rem;
  }

  .ll-specs-table td:first-child {
    font-weight: 700;
    color: var(--ll-dark);
    width: 38%;
    background: var(--ll-bg-surface);
  }

  .ll-specs-table td:last-child {
    color: var(--ll-text-body);
  }

  /* SECTION 9: WHAT'S INCLUDED */
  .ll-included-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 768px) {
    .ll-included-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ll-included-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: var(--ll-bg-surface);
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-md);
    font-weight: 600;
    color: var(--ll-dark-soft);
  }

  .ll-included-item svg {
    width: 20px;
    height: 20px;
    color: var(--ll-primary);
    flex-shrink: 0;
  }

  /* SECTION 10: SIMPLE PRICE / OFFER CARD */
  .ll-offer-container {
    max-width: 620px;
    margin: 0 auto;
    background: #ffffff;
    border: 2px solid var(--ll-primary-border);
    border-radius: var(--ll-radius-xl);
    padding: 36px 30px;
    box-shadow: var(--ll-shadow-card);
    text-align: center;
  }

  .ll-offer-kicker {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ll-primary);
    margin-bottom: 8px;
  }

  .ll-offer-pricing {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    margin: 12px 0 20px;
  }

  .ll-offer-price {
    font-family: var(--ll-font-heading);
    font-size: 3rem;
    font-weight: 800;
    color: var(--ll-dark);
    line-height: 1;
  }

  .ll-offer-compare {
    font-size: 1.4rem;
    color: var(--ll-muted);
    text-decoration: line-through;
  }

  .ll-offer-trust-badges {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 18px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ll-muted);
  }

  /* SECTION 12: FINAL CTA */
  .ll-final-cta-card {
    background: var(--ll-bg-surface);
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-xl);
    padding: 60px 32px;
    text-align: center;
  }

  .ll-final-cta-card h2 {
    margin-bottom: 10px;
  }

  .ll-final-cta-card p {
    color: var(--ll-muted);
    font-size: 1.1rem;
    margin-bottom: 28px;
  }

  /* Sticky Mobile Bar */
  .ll-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 99;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--ll-border);
    padding: 12px 18px;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transform: translateY(120%);
    transition: transform 0.25s ease;
  }

  .ll-sticky-bar.visible {
