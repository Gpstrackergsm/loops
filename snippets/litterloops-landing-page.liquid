{% comment %}
  =============================================================================
  LitterLoops™ — High-Converting Single Product Landing Page
  Theme: Direct-Response DTC E-Commerce
  Brand: LitterLoops
  Product: Non-Electric Self-Cleaning Cat Litter Box
  =============================================================================
{% endcomment %}

{%- liquid
  assign current_product = product
  if current_product == nil
    if all_products['litterloops-non-electric-self-cleaning-cat-litter-box'] != blank
      assign current_product = all_products['litterloops-non-electric-self-cleaning-cat-litter-box']
    elsif all_products['litterloops™-non-electric-self-cleaning-cat-litter-box'] != blank
      assign current_product = all_products['litterloops™-non-electric-self-cleaning-cat-litter-box']
    elsif all_products['litterloops'] != blank
      assign current_product = all_products['litterloops']
    elsif collections.frontpage.products.first != blank
      assign current_product = collections.frontpage.products.first
    elsif collections['home-page'].products.first != blank
      assign current_product = collections['home-page'].products.first
    elsif collections.all.products.first != blank
      assign current_product = collections.all.products.first
    endif
  endif

  assign current_variant = current_product.selected_or_first_available_variant
  assign variant_id = current_variant.id
  assign price = current_variant.price | default: 7900
  assign compare_price = current_variant.compare_at_price | default: 14900
  if compare_price <= price
    assign compare_price = 14900
  endif
  assign discount_percent = compare_price | minus: price | times: 100.0 | divided_by: compare_price | round
-%}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  :root {
    --ll-font-heading: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --ll-font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    
    /* Modern DTC Color Palette */
    --ll-primary: #0d9488;
    --ll-primary-hover: #0f766e;
    --ll-primary-light: #ccfbf1;
    --ll-primary-glow: rgba(13, 148, 136, 0.25);
    
    --ll-accent: #f59e0b;
    --ll-accent-light: #fef3c7;
    --ll-accent-dark: #b45309;
    
    --ll-dark: #0f172a;
    --ll-dark-soft: #1e293b;
    --ll-muted: #64748b;
    --ll-border: #e2e8f0;
    --ll-bg-light: #f8fafc;
    --ll-bg-warm: #f1f5f9;
    --ll-white: #ffffff;
    --ll-success: #10b981;
    --ll-danger: #ef4444;
    
    --ll-shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --ll-shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    --ll-shadow-lg: 0 12px 24px -4px rgba(15, 23, 42, 0.08), 0 4px 8px -2px rgba(15, 23, 42, 0.03);
    --ll-shadow-xl: 0 20px 35px -5px rgba(13, 148, 136, 0.18), 0 10px 15px -5px rgba(15, 23, 42, 0.05);
    
    --ll-radius-sm: 8px;
    --ll-radius-md: 14px;
    --ll-radius-lg: 20px;
    --ll-radius-xl: 28px;
    --ll-radius-full: 9999px;
  }

  /* Reset & Baseline */
  .ll-page * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  .ll-page {
    font-family: var(--ll-font-body);
    color: var(--ll-dark);
    background-color: var(--ll-white);
    line-height: 1.6;
    font-size: 16px;
    overflow-x: hidden;
  }

  .ll-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .ll-container-narrow {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Typography */
  .ll-h1, .ll-h2, .ll-h3, .ll-h4 {
    font-family: var(--ll-font-heading);
    font-weight: 800;
    color: var(--ll-dark);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .ll-h1 { font-size: clamp(2.2rem, 4vw, 3.4rem); }
  .ll-h2 { font-size: clamp(1.8rem, 3.2vw, 2.6rem); }
  .ll-h3 { font-size: clamp(1.25rem, 2vw, 1.5rem); }

  /* Buttons */
  .ll-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--ll-font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    padding: 18px 36px;
    border-radius: var(--ll-radius-full);
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .ll-btn-primary {
    background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
    color: var(--ll-white);
    box-shadow: 0 10px 25px -3px var(--ll-primary-glow), 0 4px 6px -2px rgba(0,0,0,0.05);
  }

  .ll-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 30px -4px var(--ll-primary-glow);
    background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  }

  .ll-btn-primary:active {
    transform: translateY(0);
  }

  .ll-btn-pulse::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    border-radius: var(--ll-radius-full);
    background: rgba(255,255,255,0.25);
    animation: llPulse 2.5s infinite cubic-bezier(0.24, 0, 0.38, 1);
  }

  @keyframes llPulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.08); opacity: 0; }
    100% { transform: scale(0.95); opacity: 0; }
  }

  .ll-btn-sm {
    padding: 10px 22px;
    font-size: 0.95rem;
  }

  .ll-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--ll-radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .ll-badge-amber {
    background-color: var(--ll-accent-light);
    color: var(--ll-accent-dark);
  }

  .ll-badge-teal {
    background-color: var(--ll-primary-light);
    color: var(--ll-primary);
  }

  /* 1. TOP ANNOUNCEMENT BAR */
  .ll-announcement-bar {
    background: linear-gradient(90deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 10px 16px;
    text-align: center;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ll-announcement-bar strong {
    color: #38bdf8;
    background: linear-gradient(90deg, #38bdf8, #2dd4bf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 2. STICKY HEADER */
  .ll-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ll-border);
    transition: all 0.3s ease;
  }

  .ll-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
  }

  .ll-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--ll-font-heading);
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--ll-dark);
    text-decoration: none;
    letter-spacing: -0.03em;
  }

  .ll-logo-icon {
    width: 32px;
    height: 32px;
    background: var(--ll-primary);
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    box-shadow: 0 4px 10px var(--ll-primary-glow);
  }

  .ll-logo span {
    color: var(--ll-primary);
  }

  .ll-header-proof {
    display: none;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ll-dark-soft);
    background: var(--ll-bg-light);
    padding: 6px 14px;
    border-radius: var(--ll-radius-full);
    border: 1px solid var(--ll-border);
  }

  .ll-header-proof .stars {
    color: #f59e0b;
    font-size: 0.95rem;
  }

  @media (min-width: 768px) {
    .ll-header-proof {
      display: flex;
    }
  }

  /* 3. HERO SECTION */
  .ll-hero {
    padding: 40px 0 60px;
    background: radial-gradient(circle at top right, rgba(204, 251, 241, 0.45) 0%, rgba(255, 255, 255, 1) 60%);
  }

  .ll-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 992px) {
    .ll-hero-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 56px;
    }
  }

  /* Hero Media Gallery Showcase */
  .ll-hero-gallery {
    position: relative;
  }

  .ll-main-card {
    background: linear-gradient(145deg, #ffffff, #f8fafc);
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-xl);
    padding: 24px;
    box-shadow: var(--ll-shadow-lg);
    position: relative;
    overflow: hidden;
  }

  .ll-floating-pill {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 10;
    background: rgba(15, 23, 42, 0.9);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: var(--ll-radius-full);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ll-floating-pill-right {
    left: auto;
    right: 20px;
    background: var(--ll-primary);
  }

  .ll-product-illustration {
    width: 100%;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, #f0fdfa 0%, #e2e8f0 100%);
    border-radius: var(--ll-radius-lg);
    position: relative;
  }

  .ll-interactive-highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 16px;
  }

  .ll-highlight-box {
    background: var(--ll-bg-light);
    border: 1px solid var(--ll-border);
    padding: 12px 10px;
    border-radius: var(--ll-radius-md);
    text-align: center;
    transition: all 0.2s ease;
  }

  .ll-highlight-box:hover {
    border-color: var(--ll-primary);
    background: var(--ll-primary-light);
  }

  .ll-highlight-box svg {
    width: 24px;
    height: 24px;
    color: var(--ll-primary);
    margin-bottom: 4px;
  }

  .ll-highlight-box span {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ll-dark);
  }

  /* Hero Content Column */
  .ll-hero-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ll-review-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ll-bg-light);
    border: 1px solid var(--ll-border);
    padding: 6px 14px;
    border-radius: var(--ll-radius-full);
    width: fit-content;
  }

  .ll-review-avatars {
    display: flex;
    margin-right: -4px;
  }

  .ll-review-avatars img, .ll-review-avatars .ll-avatar-mini {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid white;
    margin-left: -6px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e2e8f0;
    font-size: 11px;
  }

  .ll-review-avatars .ll-avatar-mini:first-child {
    margin-left: 0;
  }

  .ll-hero-headline {
    color: var(--ll-dark);
  }

  .ll-hero-headline span {
    color: var(--ll-primary);
    position: relative;
    display: inline-block;
  }

  .ll-hero-subheadline {
    font-size: 1.18rem;
    color: var(--ll-muted);
    line-height: 1.5;
  }

  /* Bullet List */
  .ll-bullet-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ll-bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ll-dark-soft);
  }

  .ll-bullet-icon {
    width: 22px;
    height: 22px;
    background: #dcfce7;
    color: #15803d;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Offer & Pricing Card */
  .ll-pricing-card {
    background: var(--ll-bg-light);
    border: 2px solid #ccfbf1;
    border-radius: var(--ll-radius-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
  }

  .ll-pricing-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ll-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .ll-current-price {
    font-family: var(--ll-font-heading);
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--ll-dark);
    line-height: 1;
  }

  .ll-compare-price {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ll-muted);
    text-decoration: line-through;
  }

  .ll-save-badge {
    background: #fee2e2;
    color: #b91c1c;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: var(--ll-radius-full);
  }

  .ll-stock-urgency {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ll-accent-dark);
    background: var(--ll-accent-light);
    padding: 8px 14px;
    border-radius: var(--ll-radius-sm);
  }

  .ll-stock-dot {
    width: 8px;
    height: 8px;
    background: var(--ll-accent);
    border-radius: 50%;
    animation: llBlink 1.4s infinite;
  }

  @keyframes llBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* Form & Actions */
  .ll-form-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ll-btn-block {
    width: 100%;
    padding: 20px;
    font-size: 1.25rem;
  }

  /* Trust Guarantees row */
  .ll-trust-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--ll-border);
  }

  .ll-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ll-muted);
  }

  .ll-trust-item svg {
    width: 20px;
    height: 20px;
    color: var(--ll-primary);
  }

  /* 4. HOW IT WORKS SECTION */
  .ll-section {
    padding: 80px 0;
  }

  .ll-section-alt {
    background-color: var(--ll-bg-light);
  }

  .ll-section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
  }

  .ll-section-tag {
    display: inline-block;
    color: var(--ll-primary);
    font-weight: 800;
    font-size: 0.88rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  .ll-section-subtitle {
    font-size: 1.15rem;
    color: var(--ll-muted);
    margin-top: 12px;
  }

  .ll-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .ll-steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ll-step-card {
    background: var(--ll-white);
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-lg);
    padding: 32px 24px;
    box-shadow: var(--ll-shadow-sm);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .ll-step-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--ll-shadow-lg);
    border-color: #99f6e4;
  }

  .ll-step-number {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--ll-primary) 0%, #0f766e 100%);
    color: white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--ll-font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    box-shadow: 0 6px 12px var(--ll-primary-glow);
  }

  .ll-step-visual {
    height: 180px;
    background: radial-gradient(circle, #f0fdfa 0%, #e2e8f0 100%);
    border-radius: var(--ll-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
  }

  .ll-step-card h3 {
    font-size: 1.3rem;
  }

  .ll-step-card p {
    color: var(--ll-muted);
    font-size: 0.95rem;
  }

  /* 5. COMPARISON TABLE */
  .ll-comparison-wrap {
    overflow-x: auto;
    background: var(--ll-white);
    border-radius: var(--ll-radius-xl);
    border: 1px solid var(--ll-border);
    box-shadow: var(--ll-shadow-md);
  }

  .ll-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 650px;
  }

  .ll-table th, .ll-table td {
    padding: 18px 22px;
    border-bottom: 1px solid var(--ll-border);
  }

  .ll-table th {
    background: var(--ll-bg-light);
    font-family: var(--ll-font-heading);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .ll-table th.ll-col-highlight,
  .ll-table td.ll-col-highlight {
    background: #f0fdfa;
    border-left: 2px solid var(--ll-primary);
    border-right: 2px solid var(--ll-primary);
  }

  .ll-table th.ll-col-highlight {
    border-top: 2px solid var(--ll-primary);
    color: var(--ll-primary);
    font-size: 1.2rem;
  }

  .ll-table tr:last-child td.ll-col-highlight {
    border-bottom: 2px solid var(--ll-primary);
  }

  .ll-feature-title {
    font-weight: 700;
    color: var(--ll-dark);
  }

  .ll-check {
    color: #10b981;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ll-cross {
    color: #ef4444;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* 6. FEATURES & PAIN POINTS GRID */
  .ll-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .ll-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .ll-features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ll-feature-card {
    background: var(--ll-white);
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-lg);
    padding: 30px;
    box-shadow: var(--ll-shadow-sm);
    transition: all 0.25s ease;
  }

  .ll-feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--ll-shadow-lg);
  }

  .ll-feature-icon {
    width: 52px;
    height: 52px;
    background: var(--ll-primary-light);
    color: var(--ll-primary);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    font-size: 24px;
  }

  .ll-feature-card h3 {
    margin-bottom: 10px;
  }

  .ll-feature-card p {
    color: var(--ll-muted);
    font-size: 0.95rem;
  }

  /* 7. SOCIAL PROOF & REVIEWS */
  .ll-reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .ll-reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .ll-reviews-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ll-review-card {
    background: var(--ll-white);
    border: 1px solid var(--ll-border);
    border-radius: var(--ll-radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--ll-shadow-sm);
  }

  .ll-stars {
    color: #f59e0b;
    font-size: 1.1rem;
    margin-bottom: 12px;
    letter-spacing: 2px;
  }

  .ll-review-text {
    font-size: 0.95rem;
    color: var(--ll-dark-soft);
    margin-bottom: 20px;
    line-height: 1.55;
  }

  .ll-review-author {
    display: flex;
    align-items: center;
    gap: 12px;
