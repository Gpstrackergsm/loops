{% comment %}
  LitterLoops™ — Video First Landing Page (Build 2026.08.25.v1318)
  Direct CDN Video: https://cdn.shopify.com/videos/c/o/v/d4417c219a0843ad8e797e10e15a6e25.mp4
{% endcomment %}

{%- liquid
  assign cp = product
  if cp == nil or cp == blank
    assign cp = all_products['litterloops-non-electric-self-cleaning-cat-litter-box']
  endif
  if cp == nil or cp == blank
    assign cp = all_products['litterloops']
  endif
  if cp == nil or cp == blank
    assign cp = collections.frontpage.products.first
  endif
  if cp == nil or cp == blank
    assign cp = collections.all.products.first
  endif
  assign vid = cp.selected_or_first_available_variant.id | default: 0
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=Manrope:wght@500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ─── TOKENS ─────────────────────────────────── */
:root {
  --brand:       #0a7c71;
  --brand-dk:    #085f57;
  --brand-lt:    #f0fdf9;
  --brand-bd:    #b2f0e8;
  --ink:         #0f1923;
  --ink-soft:    #253345;
  --muted:       #5a6b7b;
  --subtle:      #8fa0b0;
  --surface:     #ffffff;
  --wash:        #f7f9fb;
  --warm:        #fafaf8;
  --line:        #e4eaef;
  --green:       #15803d;
  --green-bg:    #dcfce7;
  --amber:       #b45309;
  --amber-bg:    #fef3c7;
  --red-bg:      #fef2f2;
  --red:         #b91c1c;
  --fh: 'Manrope', system-ui, sans-serif;
  --fb: 'Inter', system-ui, sans-serif;
  --r1: 6px; --r2: 12px; --r3: 18px; --r4: 24px; --rpill: 999px;
  --sh1: 0 1px 4px rgba(15,25,35,.05);
  --sh2: 0 4px 16px rgba(15,25,35,.07), 0 1px 3px rgba(15,25,35,.04);
  --sh3: 0 12px 32px rgba(15,25,35,.10), 0 2px 6px rgba(15,25,35,.04);
}

/* ─── RESET ──────────────────────────────────── */
.ll * { box-sizing: border-box; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }
.ll { font-family: var(--fb); color: var(--ink-soft); background: var(--surface); line-height: 1.6; overflow-x: hidden; }
img { display: block; max-width: 100%; }
a { text-decoration: none; }

/* ─── LAYOUT ─────────────────────────────────── */
.ll-w  { max-width: 1140px; margin: 0 auto; padding: 0 20px; }
.ll-wn { max-width:  780px; margin: 0 auto; padding: 0 20px; }
.ll-sec { padding: 80px 0; }
.ll-alt { background: var(--wash); }
.ll-warm { background: var(--warm); }
@media(max-width:767px){ .ll-sec { padding: 56px 0; } }

/* ─── TYPE ───────────────────────────────────── */
.ll h1,.ll h2,.ll h3,.ll h4 { font-family: var(--fh); color: var(--ink); letter-spacing: -.025em; line-height: 1.18; }
.ll h1 { font-size: clamp(2.1rem,4.8vw,3.5rem); font-weight: 900; letter-spacing: -.04em; }
.ll h2 { font-size: clamp(1.7rem,3vw,2.45rem); font-weight: 800; }
.ll h3 { font-size: 1.18rem; font-weight: 700; }
.ll h4 { font-size: .98rem; font-weight: 700; }
.ll-kicker {
  font-family: var(--fh); font-size: .75rem; font-weight: 800;
  letter-spacing: .10em; text-transform: uppercase; color: var(--brand);
  display: block; margin-bottom: 10px;
}
.ll-lead { font-size: 1.08rem; color: var(--muted); line-height: 1.7; margin-top: 12px; }
.ll-sec-hd { margin-bottom: 44px; }
.ll-sec-hd.center { text-align: center; }

/* ─── BUTTONS ────────────────────────────────── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  font-family: var(--fh); font-weight: 700; font-size: .98rem;
  padding: 14px 28px; border-radius: var(--rpill);
  border: 2px solid transparent; cursor: pointer; transition: all .18s ease; white-space: nowrap;
}
.btn-primary { background: var(--brand); color: #fff; box-shadow: 0 4px 18px rgba(10,124,113,.25); }
.btn-primary:hover { background: var(--brand-dk); box-shadow: 0 6px 24px rgba(10,124,113,.32); transform: translateY(-1px); }
.btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }
.btn-ghost:hover { border-color: var(--brand); color: var(--brand); }
.btn-lg { padding: 17px 36px; font-size: 1.08rem; }
.btn-full { width: 100%; padding: 17px; font-size: 1.08rem; }

/* ─── ANNOUNCEMENT BAR ───────────────────────── */
.ll-bar {
  background: var(--ink); color: rgba(255,255,255,.85);
  font-size: .82rem; font-weight: 600; text-align: center; padding: 9px 20px;
  font-family: var(--fh); letter-spacing: .01em;
}
.ll-bar strong { color: #fff; }

/* ─── HEADER ─────────────────────────────────── */
.ll-header {
  position: sticky; top: 0; z-index: 200;
  background: rgba(255,255,255,.96); backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
}
.ll-header-in { display: flex; align-items: center; justify-content: space-between; height: 60px; }
.ll-logo { font-family: var(--fh); font-size: 1.35rem; font-weight: 900; color: var(--ink); letter-spacing: -.04em; }
.ll-logo em { color: var(--brand); font-style: normal; }
.ll-nav { display: none; gap: 28px; }
.ll-nav a { font-size: .88rem; font-weight: 600; color: var(--muted); transition: color .15s; }
.ll-nav a:hover { color: var(--brand); }
@media(min-width:900px){ .ll-nav { display: flex; } }

/* ─── HERO ───────────────────────────────────── */
.ll-hero { padding: 52px 0 72px; background: linear-gradient(155deg, #edfaf7 0%, #fff 55%); }
.ll-hero-grid { display: grid; gap: 48px; align-items: center; }
@media(min-width:900px){ .ll-hero-grid { grid-template-columns: 55% 1fr; gap: 60px; } }

/* Gallery */
.ll-gallery { background: #fff; border: 1px solid var(--line); border-radius: var(--r4); padding: 18px; box-shadow: var(--sh3); }
.ll-gallery-vp {
  position: relative; background: linear-gradient(145deg, #edfaf7, #f7f9fb);
  border-radius: var(--r3); overflow: hidden; aspect-ratio: 4/3;
  display: flex; align-items: center; justify-content: center;
}
.ll-gallery-vp img { width: 100%; height: 100%; object-fit: contain; transition: opacity .2s; }
.gal-btn {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line);
  background: rgba(255,255,255,.92); display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--ink); transition: all .15s; box-shadow: var(--sh1);
}
.gal-btn:hover { background: var(--brand); color: #fff; border-color: var(--brand); }
.gal-btn.p { left: 10px; } .gal-btn.n { right: 10px; }
.ll-thumbs { display: flex; gap: 8px; margin-top: 12px; overflow-x: auto; }
.ll-thumb {
  width: 62px; height: 62px; flex-shrink: 0; border-radius: var(--r1);
  border: 2px solid transparent; cursor: pointer; overflow: hidden; background: var(--wash);
  transition: border-color .15s;
}
.ll-thumb img { width: 100%; height: 100%; object-fit: cover; }
.ll-thumb.on { border-color: var(--brand); }

/* Gallery placeholder */
.gal-placeholder {
  display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 36px;
}
.gal-placeholder p { font-size: .82rem; color: var(--subtle); text-align: center; max-width: 220px; line-height: 1.5; }

/* Hero copy */
.ll-hero-copy { display: flex; flex-direction: column; gap: 18px; }
.ll-tag {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--fh); font-size: .8rem; font-weight: 700; color: var(--brand);
  background: var(--brand-lt); border: 1px solid var(--brand-bd);
  padding: 5px 14px; border-radius: var(--rpill); width: fit-content;
}
.ll-hero-sub { font-size: 1.12rem; color: var(--muted); line-height: 1.62; }
.ll-checks { display: flex; flex-wrap: wrap; gap: 8px 18px; }
.ll-check { display: flex; align-items: center; gap: 7px; font-size: .88rem; font-weight: 600; color: var(--ink-soft); }
.ll-check::before { content: '✓'; color: var(--brand); font-weight: 900; }

/* Price */
.ll-price-row { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; padding: 6px 0; }
.ll-price { font-family: var(--fh); font-size: 2.5rem; font-weight: 900; color: var(--ink); line-height: 1; }
.ll-was { font-size: 1.2rem; color: var(--subtle); text-decoration: line-through; }
.ll-save { font-size: .82rem; font-weight: 700; color: var(--green); background: var(--green-bg); padding: 4px 10px; border-radius: var(--rpill); }

/* Price context note */
.ll-price-context {
  font-size: .82rem; color: var(--muted); font-style: italic;
  border-left: 3px solid var(--brand-bd); padding-left: 10px; line-height: 1.5;
}

.ll-cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
.ll-micro-trust { display: flex; align-items: center; gap: 16px; font-size: .8rem; color: var(--subtle); margin-top: 4px; }

/* ─── MECHANISM STRIP ────────────────────────── */
.ll-mech { background: var(--ink); padding: 20px 0; }
.ll-mech-in {
  display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
}
.ll-mech-step { display: flex; align-items: center; gap: 10px; padding: 10px 22px; }
.ll-mech-num { font-family: var(--fh); font-size: .7rem; font-weight: 800; color: var(--brand); letter-spacing: .1em; }
.ll-mech-label { font-family: var(--fh); font-size: .98rem; font-weight: 800; color: #fff; }
.ll-mech-arr { color: #334155; font-size: 1.1rem; }
@media(max-width:480px){ .ll-mech-arr { display: none; } .ll-mech-step { padding: 8px 14px; } }

/* ─── SOCIAL PROOF STRIP ─────────────────────── */
.ll-social-strip {
  background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  padding: 18px 0; overflow: hidden;
}
.ll-social-track {
  display: flex; gap: 32px; align-items: center;
  animation: scroll-track 35s linear infinite;
  width: max-content;
}
.ll-social-track:hover { animation-play-state: paused; }
@keyframes scroll-track { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
.ll-social-item {
  display: flex; align-items: center; gap: 10px; flex-shrink: 0;
  font-size: .88rem; color: var(--muted); font-weight: 500;
}
.ll-social-item strong { color: var(--ink); font-weight: 700; }
.ll-social-item::before { content: '"'; color: var(--brand); font-size: 1.4rem; font-family: var(--fh); line-height: 1; }

/* ─── EXPLAIN ────────────────────────────────── */
.ll-explain-grid { display: grid; gap: 40px; align-items: center; }
@media(min-width:900px){ .ll-explain-grid { grid-template-columns: 1fr 1fr; gap: 60px; } }
.ll-explain-img {
  border-radius: var(--r4); overflow: hidden; background: var(--wash);
  aspect-ratio: 1; display: flex; align-items: center; justify-content: center;
  border: 1px solid var(--line); box-shadow: var(--sh2);
}
.ll-explain-img img { width: 100%; height: 100%; object-fit: contain; }
.ll-explain-copy { display: flex; flex-direction: column; gap: 18px; }
.ll-explain-copy p { color: var(--muted); font-size: 1.02rem; line-height: 1.7; }

/* ─── HOW IT WORKS ───────────────────────────── */
.ll-steps { display: grid; gap: 20px; }
@media(min-width:768px){ .ll-steps { grid-template-columns: repeat(3,1fr); } }
.ll-step {
  background: #fff; border: 1px solid var(--line); border-radius: var(--r4);
  padding: 30px 24px; box-shadow: var(--sh2); display: flex; flex-direction: column; gap: 12px;
  position: relative; overflow: hidden;
}
.ll-step::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--brand); }
.ll-step-badge {
  font-family: var(--fh); font-size: .72rem; font-weight: 800; letter-spacing: .08em;
  color: var(--brand); background: var(--brand-lt); border: 1px solid var(--brand-bd);
  padding: 4px 12px; border-radius: var(--rpill); width: fit-content;
}
.ll-step h3 { font-size: 1.25rem; }
.ll-step p { font-size: .93rem; color: var(--muted); line-height: 1.6; }
.ll-step-img { width: 100%; aspect-ratio: 4/3; border-radius: var(--r2); overflow: hidden; background: var(--wash); margin-top: 6px; }
.ll-step-img img { width: 100%; height: 100%; object-fit: contain; }

/* ─── PRICE COMPARISON ───────────────────────── */
.ll-vs-grid { display: grid; gap: 16px; }
@media(min-width:768px){ .ll-vs-grid { grid-template-columns: 1fr 1fr; } }
.ll-vs-card {
  border-radius: var(--r3); padding: 28px 24px;
  border: 2px solid var(--line); background: #fff;
}
.ll-vs-card.featured {
  border-color: var(--brand); background: var(--brand-lt);
  box-shadow: 0 4px 20px rgba(10,124,113,.12);
}
.ll-vs-card h3 { margin-bottom: 16px; font-size: 1.1rem; }
.ll-vs-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid rgba(0,0,0,.06); font-size: .9rem; }
.ll-vs-row:last-child { border-bottom: none; }
.ll-vs-check { width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: .72rem; font-weight: 800; }
.ll-vs-check.y { background: var(--green-bg); color: var(--green); }
.ll-vs-check.n { background: var(--red-bg); color: var(--red); }
.ll-vs-price-tag {
  display: inline-block; font-family: var(--fh); font-size: 2rem; font-weight: 900;
  color: var(--brand); margin: 12px 0 4px;
}
.ll-vs-compare { font-size: .82rem; color: var(--muted); }

/* ─── BENEFITS ───────────────────────────────── */
.ll-benefits { display: grid; gap: 16px; }
@media(min-width:600px){ .ll-benefits { grid-template-columns: repeat(2,1fr); } }
@media(min-width:900px){ .ll-benefits { grid-template-columns: repeat(3,1fr); } }
.ll-benefit {
  background: #fff; border: 1px solid var(--line); border-radius: var(--r3);
  padding: 24px 20px; display: flex; flex-direction: column; gap: 10px;
}
.ll-benefit-ico { width: 42px; height: 42px; border-radius: var(--r2); background: var(--brand-lt); border: 1px solid var(--brand-bd); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
.ll-benefit h3 { font-size: 1rem; }
.ll-benefit p { font-size: .88rem; color: var(--muted); line-height: 1.55; }

/* ─── OBJECTIONS ─────────────────────────────── */
.ll-obj-list { display: flex; flex-direction: column; gap: 10px; }
.ll-obj {
  background: #fff; border: 1px solid var(--line); border-radius: var(--r2); overflow: hidden;
  transition: border-color .15s;
}
.ll-obj.on { border-color: var(--brand); }
.ll-obj-q {
  padding: 18px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px;
  cursor: pointer; user-select: none;
}
.ll-obj-q > span { font-family: var(--fh); font-size: .97rem; font-weight: 700; color: var(--ink); line-height: 1.3; }
.ll-obj-icon {
  width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0; border: 1px solid var(--line);
  background: var(--wash); display: flex; align-items: center; justify-content: center;
  color: var(--muted); transition: all .15s; font-size: .9rem; font-weight: 800; font-family: var(--fh);
}
.ll-obj.on .ll-obj-icon { background: var(--brand); color: #fff; border-color: var(--brand); }
.ll-obj-a {
  display: none; padding: 0 20px 18px;
  font-size: .92rem; color: var(--muted); line-height: 1.68;
}
.ll-obj.on .ll-obj-a { display: block; }
.ll-obj-note {
  display: inline-block; margin-top: 8px; font-size: .82rem; font-weight: 600;
  color: var(--amber); background: var(--amber-bg); border-radius: var(--rpill); padding: 3px 10px;
}

/* ─── DARK CARD (Robot Comparison) ──────────── */
.ll-dark {
  background: var(--ink); border-radius: var(--r4); padding: 52px 40px;
  text-align: center; max-width: 860px; margin: 0 auto;
}
.ll-dark .ll-kicker { color: #2dd4bf; }
.ll-dark h2 { color: #fff; margin-bottom: 14px; }
.ll-dark p { color: #94a3b8; font-size: 1.02rem; line-height: 1.7; max-width: 580px; margin: 0 auto; }
.ll-dark-pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px; }
.ll-dark-pill { font-family: var(--fh); font-size: .86rem; font-weight: 700; color: #fff; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15); padding: 7px 16px; border-radius: var(--rpill); }
@media(max-width:600px){ .ll-dark { padding: 36px 20px; } }

/* ─── SPECS ──────────────────────────────────── */
.ll-spec-wrap { border: 1px solid var(--line); border-radius: var(--r3); overflow: hidden; box-shadow: var(--sh1); }
.ll-spec-table { width: 100%; border-collapse: collapse; }
.ll-spec-table tr { border-bottom: 1px solid var(--line); }
.ll-spec-table tr:last-child { border-bottom: none; }
.ll-spec-table td { padding: 14px 20px; font-size: .93rem; }
.ll-spec-table td:first-child { font-family: var(--fh); font-weight: 700; color: var(--ink); background: var(--wash); width: 40%; }
.ll-spec-table td:last-child { color: var(--ink-soft); }

/* ─── INCLUDED ───────────────────────────────── */
.ll-included { display: grid; gap: 10px; }
@media(min-width:600px){ .ll-included { grid-template-columns: repeat(2,1fr); } }
.ll-inc-item {
  display: flex; align-items: center; gap: 12px; padding: 14px 16px;
  background: #fff; border: 1px solid var(--line); border-radius: var(--r2);
}
.ll-inc-check { width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0; background: var(--brand-lt); border: 1px solid var(--brand-bd); display: flex; align-items: center; justify-content: center; color: var(--brand); font-size: .78rem; font-weight: 900; }
.ll-inc-item span { font-size: .92rem; font-weight: 600; color: var(--ink-soft); }

/* ─── OFFER CARD ─────────────────────────────── */
.ll-offer {
  max-width: 600px; margin: 0 auto; background: #fff;
  border: 2px solid var(--brand-bd); border-radius: var(--r4);
  padding: 38px 30px; text-align: center;
  box-shadow: 0 6px 30px rgba(10,124,113,.10);
}
.ll-offer-name { font-family: var(--fh); font-size: 1.5rem; font-weight: 900; letter-spacing: -.035em; }
.ll-offer-desc { font-size: .88rem; color: var(--muted); margin-top: 4px; }
.ll-offer-row { display: flex; align-items: baseline; justify-content: center; gap: 14px; flex-wrap: wrap; margin: 14px 0; }
.ll-offer-price { font-family: var(--fh); font-size: 3rem; font-weight: 900; color: var(--ink); line-height: 1; }
.ll-offer-was { font-size: 1.4rem; color: var(--subtle); text-decoration: line-through; }
.ll-offer-note { font-size: .82rem; color: var(--muted); margin-bottom: 18px; }
.ll-trust-pills { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 18px; margin-top: 16px; }
.ll-trust-pill { font-size: .8rem; font-weight: 600; color: var(--muted); display: flex; align-items: center; gap: 5px; }

/* ─── TRUST GRID ─────────────────────────────── */
.ll-trust-grid { display: grid; gap: 12px; }
@media(min-width:480px){ .ll-trust-grid { grid-template-columns: repeat(2,1fr); } }
@media(min-width:900px){ .ll-trust-grid { grid-template-columns: repeat(4,1fr); } }
.ll-trust-card {
  background: #fff; border: 1px solid var(--line); border-radius: var(--r3);
  padding: 20px 16px; text-align: center; display: flex; flex-direction: column; gap: 8px; align-items: center;
}
.ll-trust-card-ico { font-size: 1.5rem; }
.ll-trust-card h4 { font-size: .92rem; }
.ll-trust-card p { font-size: .82rem; color: var(--muted); line-height: 1.45; }

/* ─── FAQ ────────────────────────────────────── */
.ll-faq-list { display: flex; flex-direction: column; gap: 8px; }
.ll-faq { background: #fff; border: 1px solid var(--line); border-radius: var(--r2); overflow: hidden; transition: border-color .15s; }
.ll-faq.on { border-color: var(--brand); }
.ll-faq-q { padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; gap: 14px; cursor: pointer; user-select: none; }
.ll-faq-q > span { font-family: var(--fh); font-size: .95rem; font-weight: 700; color: var(--ink); }
.ll-chevron { width: 20px; height: 20px; flex-shrink: 0; color: var(--muted); transition: transform .15s; }
.ll-faq.on .ll-chevron { transform: rotate(180deg); color: var(--brand); }
.ll-faq-a { display: none; padding: 0 20px 16px; font-size: .91rem; color: var(--muted); line-height: 1.65; }
.ll-faq.on .ll-faq-a { display: block; }

/* ─── FINAL CTA ──────────────────────────────── */
.ll-final { text-align: center; }
.ll-final h2 { margin-bottom: 10px; }
.ll-final p { font-size: 1.05rem; color: var(--muted); margin-bottom: 24px; }

/* ─── FOOTER ─────────────────────────────────── */
.ll-footer { padding: 28px 0; border-top: 1px solid var(--line); text-align: center; color: var(--subtle); font-size: .82rem; }

/* ─── STICKY ─────────────────────────────────── */
.ll-sticky {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;
  background: rgba(255,255,255,.97); backdrop-filter: blur(14px);
  border-top: 1px solid var(--line); padding: 12px 18px;
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  transform: translateY(120%); transition: transform .25s ease;
  box-shadow: 0 -4px 20px rgba(15,25,35,.07);
}
.ll-sticky.show { transform: translateY(0); }
